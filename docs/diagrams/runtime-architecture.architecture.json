  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Vendor \u2192 collector \u2192 ingest \u2192 MongoDB \u2192 API \u2192 UI.",
        "Classify and health-evaluate happen inside that one upsert.",
        "A second write path bypasses ingest entirely: per-cluster jobs reconcile OpenShift membership straight into MongoDB (ADR-0024)."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Collectors initiate every vendor call and are strictly read-only.",
        "No API authentication yet \u2014 deferred, and the release gate."
      ]
    },
    {
      "dot": "emerald",
      "title": "Collectors",
      "items": [
        "One CronJob per manager type; every type has a collector except UCS_MANAGER, reached through UCS_CENTRAL.",
        "Intersight ~120 requests per fleet; Redfish ~25 per BMC."
      ]
    },
    {
      "dot": "amber",
      "title": "Failure behaviour",
      "items": [
        "An unread field is None, never 0 \u2014 the stored value survives.",
        "A partial run exits 3; Redis loss degrades latency only."
      ]
    },
    {
      "dot": "violet",
      "title": "Serving the UI (ADR-0033)",
      "items": [
        "The browser loads the whole fleet once, as flat rows, and filters/sorts/searches locally.",
        "Polled every 30s; an unchanged fleet is a 304, not a re-download."
      ]
    }
  ]
