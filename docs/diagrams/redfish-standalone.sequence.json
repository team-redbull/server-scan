    },
    {
      "participant": "inventory",
      "from": 185,
      "to": 246,
      "type": "security"
    },
    {
      "participant": "bmc",
      "from": 300,
      "to": 626,
      "type": "external"
    },
    {
      "participant": "ingest",
      "from": 685,
      "to": 826,
