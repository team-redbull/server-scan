  "diagram_type": "sequence",
  "meta": {
    "title": "Redfish Standalone Collector Run",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      960
    ],
    "views": [
      {
        "id": "fleet-from-file",
        "label": "Fleet from the inventory file",
        "focus": [
          "cronjob",
          "inventory",
          "bmc"
        ],
        "note": "No manager: the TOML says which BMCs exist, and each gets its own session."
      },
      {
        "id": "resource-walk",
        "label": "The ~25-GET walk per BMC",
        "focus": [
          "cronjob",
          "bmc"
        ],
        "note": "Systems first, then every sub-collection; a 404 becomes None, never zero."
      },
      {
        "id": "ingest",
        "label": "One write per server",
        "focus": [
          "cronjob",
          "ingest",
          "mongo"
        ],
        "note": "Classify, evaluate health, audit and upsert in the same write."
      }
    ]
  },
  "participants": [
