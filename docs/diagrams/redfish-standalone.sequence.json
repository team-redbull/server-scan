      "variant": "emphasis"
    },
    {
      "id": "stored",
      "from": "mongo",
      "to": "ingest",
      "y": 785,
      "label": "Server (None fields carried forward)",
      "variant": "return"
    },
    {
      "id": "yielded",
      "from": "ingest",
      "to": "cronjob",
      "y": 820,
      "label": "next server",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "cronjob",
      "from": 185,
      "to": 830,
