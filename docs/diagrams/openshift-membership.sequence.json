  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Absence is the only way back (ADR-0024)",
      "items": [
        "Kubernetes never reports a removal",
        "A run claims what it sees, frees what it doesn't",
        "AVAILABLE is the default; there is no UNKNOWN"
      ]
    },
    {
      "dot": "rose",
      "title": "Per-cluster scope is the safety",
      "items": [
        "A job frees only servers naming its own cluster/MCE",
        "Failed read: exit 1 before any write",
        "Empty read: also refuses (RBAC, not an empty cluster)"
      ]
    },
    {
      "dot": "amber",
      "title": "Kept apart on purpose",
      "items": [
        "Writes Server.openshift only, never via IngestService",
        "Name verdict vs cluster fact: a mismatch is the signal",
        "httpx to kubernetes.default.svc, no SDK, two GETs"
      ]
    }
  ]
}
