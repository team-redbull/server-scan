# Copy to .env for local development. Never commit the real .env file.
# All variables are prefixed INVENTORY_ and consumed by
# backend/app/config/settings.py — do not read os.environ anywhere else.

# --- Service ---
INVENTORY_SERVICE_NAME=server-scan-api
INVENTORY_ENVIRONMENT=development

# --- HTTP ---
INVENTORY_HOST=0.0.0.0
INVENTORY_PORT=8080
# Comma-separated list of origins the frontend is served from.
INVENTORY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MongoDB ---
INVENTORY_MONGO_URI=mongodb://localhost:27017
INVENTORY_MONGO_DB=server-scan
INVENTORY_MONGO_CONNECT_TIMEOUT_MS=5000
INVENTORY_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
INVENTORY_MONGO_SOCKET_TIMEOUT_MS=10000
INVENTORY_MONGO_MAX_POOL_SIZE=100
INVENTORY_MONGO_MIN_POOL_SIZE=0

# --- Redis (ephemeral cache only; MongoDB is always the source of truth) ---
INVENTORY_REDIS_URI=redis://localhost:6379/0
INVENTORY_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
INVENTORY_REDIS_SOCKET_TIMEOUT_SECONDS=2.0
INVENTORY_REDIS_MAX_CONNECTIONS=50
INVENTORY_CACHE_DEFAULT_TTL_SECONDS=300

# --- Pagination ---
INVENTORY_DEFAULT_PAGE_SIZE=50
INVENTORY_MAX_PAGE_SIZE=200
# Signs opaque keyset-pagination cursors. Override in production.
INVENTORY_CURSOR_SECRET=dev-insecure-cursor-secret-change-in-production

# --- GET /servers/available ---
# Caps `?count=` in pattern mode, so a caller can't accidentally pay the
# live-recheck cost of the whole matching fleet in one call.
INVENTORY_MAX_AVAILABLE_COUNT=20
# `token:alias` pairs: a `?pattern=` that is exactly one configured token
# also matches the alias regex. See
# docs/adr/0032-available-server-lookup-api.md.
INVENTORY_CAPACITY_ALIASES="5tb:hypershift(?!-data),10tb:hypershift-data"

# --- Sites ---
# `code:Display Name` pairs. Code is the token parsed out of a server's own
# hostname (`ocp4-prod-tlv-infra-01` -> site `tlv`): lowercase letters,
# digits, single hyphens. This is the only place sites are defined — see
# docs/adr/0018-sites-from-configuration.md.
#
# The code half may itself be `|`-separated aliases — e.g. `znif|prep:Znif`
# — when more than one naming convention refers to the same site. The first
# token is canonical (site_id, every URL); the rest are other tokens a
# hostname may carry that combine onto that one site card.
INVENTORY_SITES="nyc:New York City,tlv:Tel Aviv,bat-yam:Bat Yam,five:Site Five"

# --- GPU model catalog ---
# No management plane this platform collects from reports a GPU's memory
# size, so a built-in table of 30 cards fills it in; this OVERRIDES that
# table per identifier rather than replacing it, `PID:Friendly Name:VRAM_GB`
# triples, comma-separated. See
# docs/adr/0021-built-in-gpu-catalog-with-model-matching.md.
#
#   INVENTORY_GPU_MODELS="P1001-200:NVIDIA A100 40GB:40,P1010-200:NVIDIA H100 80GB:80"
INVENTORY_GPU_MODELS=""

# --- Network interface OS names ---
# A BMC's hardware NIC name (Dell's FQDD, e.g. NIC.Slot.8-1-1) can't be
# derived from the Linux name (ens8f0np0) the OS assigns — stated here once,
# learned by booting a host and running `ip link`. Keyed on FQDD kind,
# ordered by port. Empty means the UI shows only the hardware name.
INVENTORY_NIC_OS_NAMES="Integrated.1=eno12399np0,eno12409np1;Slot.2=ens2f0np0,ens2f1np1;Slot.8=ens8f0np0,ens8f1np1;Slot.33=ens33f0np0,ens33f1np1"

# --- Classification regex safety ---
INVENTORY_REGEX_MAX_PATTERN_LENGTH=200
INVENTORY_REGEX_MATCH_TIMEOUT_SECONDS=0.25

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
INVENTORY_LOG_LEVEL=INFO

# --- Metrics ---
INVENTORY_METRICS_ENABLED=true
# A server not successfully collected for this long counts toward the
# `server_scan_servers_stale` gauge (ADR-0029). Two 6-hour collector cycles.
INVENTORY_STALE_AFTER_SECONDS=43200
# Shortest gap between two MongoDB fleet-snapshot queries behind /metrics.
INVENTORY_METRICS_FLEET_REFRESH_SECONDS=30

# --- Collectors (tools/run_collector.py, not the API process) ---
# Per-request socket timeout when talking to a vendor manager.
INVENTORY_COLLECTOR_CONNECT_TIMEOUT_SECONDS=15.0

# Which servers a collector may ingest, matched against the server's name
# (`re.search`). Empty collects everything; a non-match is never fetched at
# all. Not the UPI-vs-hosted distinction — that's classification rules over
# what's already collected.
#
#   uv run python -m tools.run_collector --manager-type UCS_CENTRAL --dry-run
INVENTORY_COLLECTOR_NAME_PATTERN=^ocp

# Per-collector overrides of the pattern above, for an estate whose vendors
# don't share one naming scheme. Unset (commented out) inherits the global;
# set-but-empty collects everything for that collector alone — the only way
# to opt one out of a non-empty global.
# INVENTORY_UCS_CENTRAL_NAME_PATTERN=
# INVENTORY_INTERSIGHT_NAME_PATTERN=
# INVENTORY_OME_NAME_PATTERN=
# INVENTORY_ONEVIEW_NAME_PATTERN=
# Redfish is the one collector the global never reaches (see below), so
# setting this is the only way to filter it at all.
# INVENTORY_REDFISH_NAME_PATTERN=

# --- OpenShift membership jobs (tools/collect_openshift.py) ------------
#
#   python3 -m tools.collect_openshift --source nodes  --dry-run
#   python3 -m tools.collect_openshift --source agents --dry-run
#
# A different question from the collectors above: not what hardware
# exists, but whether a cluster is using it. These run *inside* each
# cluster, deployed per-cluster by ArgoCD from `cronjobs/`, and reach
# their own API server through the pod's ServiceAccount — so there is no
# endpoint and no credential here, unlike every vendor above.
#
# Not set for the API process; only the CronJobs read them.

# Which cluster this pod is in. Written onto every server the nodes job
# claims, and the scope it is allowed to release: a job frees only
# servers already naming its own cluster, never another's.
INVENTORY_OPENSHIFT_CLUSTER_NAME=

# Which MCE this pod is, for the agents job. Same role as the above.
INVENTORY_OPENSHIFT_MCE_NAME=

# Nodes that are not fleet capacity, matched as name substrings. Applied
# *after* the `node-role.kubernetes.io/worker` label selector, not instead
# of it: infra nodes usually carry the worker label too, while a name list
# alone would misfire on a node called `compute-infra-01`.
INVENTORY_OPENSHIFT_EXCLUDE_NAME_PARTS=infra,control-plane

INVENTORY_OPENSHIFT_REQUEST_TIMEOUT_SECONDS=30.0

# --- Vendor manager connections ---
# One endpoint plus one login per manager type; no Manager documents, no
# secret directory to mount. Leaving a vendor blank means no collector for
# it. IPs are bare hostnames, never URLs — each SDK builds its own URL and
# a scheme here mangles it. In Kubernetes these come from a Secret via
# envFrom; see the `collectors.*` blocks in
# deploy/helm/server-scan/values.yaml.

# Cisco UCS Central — the endpoint and login for Central itself. Central
# reports every registered domain's own address, so this is the only Cisco
# endpoint needed; see docs/adr/0009 for the data path.
INVENTORY_UCS_CENTRAL_IP=
INVENTORY_UCS_CENTRAL_USERNAME=
INVENTORY_UCS_CENTRAL_PASSWORD=

# Cisco UCS Manager — login only, no endpoint. One account that
# authenticates against every domain Central discovers; a domain that
# rejects it fails that domain alone, without aborting the run.
INVENTORY_UCS_MANAGER_USERNAME=
INVENTORY_UCS_MANAGER_PASSWORD=

# How many domains the collector talks to at once.
INVENTORY_UCS_CENTRAL_DOMAIN_CONCURRENCY=4

# --- HPE: OneView, and only OneView ---
# One collection standard for all HP hardware regardless of iLO generation —
# no BMC login, no Redfish pass. See
# docs/adr/0022-oneview-only-hpe-collector.md.
#
#   uv run python -m tools.run_collector --manager-type ONEVIEW --dry-run
INVENTORY_ONEVIEW_IP=
INVENTORY_ONEVIEW_USERNAME=
INVENTORY_ONEVIEW_PASSWORD=

# PSUs are tried the cheap bulk-sweep way first, falling back to a
# per-server call only where needed. Turn off for an appliance that
# struggles with the fan-out.
INVENTORY_ONEVIEW_COLLECT_PSUS=true
# HPE documents no rate limit, and one appliance is a single point of
# failure for up to 2500 servers, so keep the fan-out modest.
INVENTORY_ONEVIEW_PSU_CONCURRENCY=8

# Same shape, for /processors — the only source OneView has for cpu_threads.
INVENTORY_ONEVIEW_COLLECT_CPU_THREADS=true
INVENTORY_ONEVIEW_CPU_THREADS_CONCURRENCY=8

# `X-Api-Version`. 0 auto-discovers and clamps to the newest version this
# collector was written against; set a number only to pin or roll back.
INVENTORY_ONEVIEW_API_VERSION=0

# Explicit `count` on every collection GET — see docs/hpe-collectors.md for
# why `count=-1` ("all") is not safe to rely on.
INVENTORY_ONEVIEW_PAGE_SIZE=256

# Off because an air-gapped appliance typically ships a self-signed cert.
INVENTORY_ONEVIEW_VERIFY_TLS=false

# --- Dell: OME discovers, Redfish collects ---
# OME names each server and its iDRAC address; hardware is then read from
# each server's own BMC over Redfish — an iDRAC doesn't know the server's
# hostname, and OME doesn't report measured hardware. See
# docs/adr/0020-dell-identity-from-ome-hardware-from-redfish.md.
#
#   uv run python -m tools.run_collector --manager-type OPENMANAGE --dry-run
INVENTORY_OME_IP=
INVENTORY_OME_USERNAME=
INVENTORY_OME_PASSWORD=

# The iDRAC account, used against every Dell BMC. Read-only is enough.
INVENTORY_OME_BMC_USERNAME=
INVENTORY_OME_BMC_PASSWORD=
INVENTORY_OME_BMC_PORT=443

# iDRACs ship a factory self-signed cert. INVENTORY_REDFISH_CA_BUNDLE plus
# this set to true is the scalable fix.
INVENTORY_OME_BMC_VERIFY_TLS=false

# Everything else about talking to a BMC (timeouts, budgets, fleet
# concurrency, auth-failure guard) is the shared INVENTORY_REDFISH_*
# settings below — same protocol, one set of knobs.

# --- Cisco Intersight collector ---
# No username/password path exists — every request is signed with an API
# key, minted under Settings > API Keys against a Read-Only role. See
# docs/adr/0017-intersight-collector.md.
#
#   uv run python -m tools.verify_intersight          # read-only probe
#   uv run python -m tools.run_collector --manager-type INTERSIGHT --dry-run
#
# API_KEY_ID is the id shown beside the key. API_KEY_PEM is its private
# half, unencrypted (v2 "BEGIN RSA PRIVATE KEY" or v3 "BEGIN EC PRIVATE
# KEY" both work). No key file to mount — the PEM rides in this variable:
#
#   INVENTORY_INTERSIGHT_API_KEY_PEM="$(cat ~/intersight-key.pem)"
#
# IP is "intersight.com" for SaaS, or an on-prem appliance FQDN — an
# air-gapped site needs the latter; a *Connected* appliance still calls home.
INVENTORY_INTERSIGHT_IP=
INVENTORY_INTERSIGHT_API_KEY_ID=
INVENTORY_INTERSIGHT_API_KEY_PEM=

# Which servers to collect, by how Intersight manages them. UCSM is
# deliberately absent — those are exactly the servers UCS Central already
# owns. Add UCSM only for domains not registered with UCS Central at all.
INVENTORY_INTERSIGHT_MANAGEMENT_MODES=Intersight,IntersightStandalone

# No TLS-verification setting here on purpose: this collector never
# verifies the endpoint's certificate, unconditionally, by explicit user
# decision. See intersight.client.IntersightClient.

# $top. 1000 is the API's documented maximum.
INVENTORY_INTERSIGHT_PAGE_SIZE=1000
# Read is bounded separately from connect because a fleet-wide page is a
# large response. The run budget is enforced in-process so a throttled run
# still ends with a summary; a CronJob activeDeadlineSeconds kill reports
# nothing.
INVENTORY_INTERSIGHT_READ_TIMEOUT_SECONDS=60
INVENTORY_INTERSIGHT_RUN_BUDGET_SECONDS=1800

# --- Standalone Redfish collector ---
# For machines no aggregator owns — any conformant BMC, reached one at a
# time. See docs/adr/0016-redfish-standalone-collector.md.
#
#   uv run python -m tools.run_collector --manager-type REDFISH_STANDALONE --dry-run
#
# No INVENTORY_REDFISH_IP: the endpoints are the hosts listed in the
# inventory file below. INVENTORY_COLLECTOR_NAME_PATTERN does NOT apply
# here — a BMC doesn't know the server's hostname, so the inventory file IS
# the filter. Treat it as review-gated: it decides where credentials go.
# INVENTORY_REDFISH_NAME_PATTERN overrides that exemption if you do want a
# name filter here as well.

# The fleet list. A TOML file, or a directory of *.toml for a sharded
# estate. See docs/examples/redfish-inventory.example.toml.
INVENTORY_REDFISH_INVENTORY_FILE=/root/redfish-inventory.toml

# Named per-host logins, optional — see
# docs/examples/redfish-credentials.example.toml. Most estates give each
# BMC its own account.
INVENTORY_REDFISH_CREDENTIALS_FILE=/root/redfish-credentials.toml

# The fleet-wide fallback, used by any host that resolves no other
# credential.
INVENTORY_REDFISH_USERNAME=
INVENTORY_REDFISH_PASSWORD=

# PEM bundle trusted in addition to the system store (an internal CA, or
# Dell's signing cert). Turning verification off is per-host, in the
# inventory file, with a required written reason — no global switch.
INVENTORY_REDFISH_CA_BUNDLE=
INVENTORY_REDFISH_TLS_MIN_VERSION=TLSv1_2

# Connect bounds "is this host there at all"; read bounds a BMC that
# answered but is slow.
INVENTORY_REDFISH_CONNECT_TIMEOUT_SECONDS=10.0
INVENTORY_REDFISH_READ_TIMEOUT_SECONDS=30.0

# Total wall clock per host, and for the whole run — neither socket timeout
# bounds these. The run budget must stay below the CronJob's
# activeDeadlineSeconds so the process reports what it collected instead of
# being killed with no summary.
INVENTORY_REDFISH_HOST_BUDGET_SECONDS=180.0
INVENTORY_REDFISH_RUN_BUDGET_SECONDS=3600.0

# BMCs read at once.
INVENTORY_REDFISH_FLEET_CONCURRENCY=16
