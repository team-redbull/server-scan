# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/

# uv
uv.lock.bak

# Node / frontend
node_modules/
dist/
.vite/
*.local

# Env / secrets
# Real Redfish inventories and BMC credential files. Only the
# `*.example.toml` under docs/examples/ is ever committed — a raw
# inventory discloses the estate's topology, and a credentials file is a
# fleet-wide root-equivalent secret. See docs/adr/0016.
redfish-inventory.toml
redfish-inventory.d/
**/redfish-credentials*.toml
!docs/examples/redfish-credentials.example.toml
deploy/secrets*.yaml
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Local Claude Code plugin state (ruflo/claude-flow, memory tooling) —
# not part of this repo's own build or runtime.
.swarm/
ruvector.db

# Containers
*.tar

# Test artifacts
tests/**/__snapshots__/
playwright-report/
test-results/

**/.claude-flow/
# ruflo/claude-flow's self-tuning benchmark state: a machine-specific
# "champion" config adopted from a local benchmark run, not a project
# decision. Regenerates on its own; committing it just adds diff noise.
.claude/.proven-config-version
.claude/proven-config.json
# Probe output carried back from a site (docs/field-test-checklist.md):
# holds server names, serials and management addresses, never committed.
intersight-verify.txt
intersight-dryrun.txt
ucs-dryrun.txt

# archify visual-check evidence: regenerable screenshots and receipts,
# not the deliverable. The .architecture.json spec and .html are committed.
docs/diagrams/*.visual-check.*
