{
  "title": "Server Inventory Platform — Fleet & Collectors",
  "uid": "server-scan-fleet",
  "description": "Fleet health, vendor collectors and OpenShift membership jobs for the server-scan inventory platform. Built from app.observability.metrics + the server_scan: recording rules in deploy/helm/server-scan/templates/backend-prometheusrule.yaml (ADR-0029). Requires metrics.serviceMonitor.enabled and metrics.prometheusRule.enabled on the Helm chart.",
  "tags": ["server-scan", "fleet", "adr-0029"],
  "style": "dark",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(server_scan:servers:max, namespace)", "refId": "namespace" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "source_provider",
        "label": "Collector",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": {
          "query": "label_values(server_scan:servers:max{namespace=~\"$namespace\"}, source_provider)",
          "refId": "source_provider"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": {
          "query": "label_values(server_scan:cluster_servers_held:max{namespace=~\"$namespace\"}, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "ServerScan alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "ALERTS{alertname=~\"ServerScan.*\", alertstate=\"firing\", namespace=~\"$namespace\"}",
        "titleFormat": "{{alertname}}",
        "tagKeys": "source_provider,cluster,kind,reported_by"
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Fleet overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },

    {
      "id": 1, "type": "stat", "title": "Total servers",
      "description": "sum(server_scan:servers:max) — the fleet, filtered by the Collector variable.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(server_scan:servers:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"})", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2, "type": "stat", "title": "In maintenance",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "server_scan:servers_in_maintenance:max{namespace=~\"$namespace\"}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 3, "type": "stat", "title": "Duplicate name groups",
      "description": "Distinct names shared by more than one document (docs/adr/0016's duplicate-server update).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "server_scan:duplicate_name_groups:max{namespace=~\"$namespace\"}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 4, "type": "stat", "title": "Duplicate name servers",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "server_scan:duplicate_name_servers:max{namespace=~\"$namespace\"}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 2 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 5, "type": "stat", "title": "Fleet gauge query failures (15m)",
      "description": "server_scan_fleet_snapshot_failures_total — every server_scan_* gauge freezes at its last value when this fires. Almost always MongoDB.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "sum(increase(server_scan_fleet_snapshot_failures_total{namespace=~\"$namespace\"}[15m]))", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 6, "type": "stat", "title": "ServerScan alerts firing",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "count(ALERTS{alertname=~\"ServerScan.*\", alertstate=\"firing\", namespace=~\"$namespace\"}) or vector(0)", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" }
    },

    {
      "id": 7, "type": "bargauge", "title": "Servers by health severity",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "server_scan:servers_by_health:max{namespace=~\"$namespace\"}", "legendFormat": "{{severity}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "CRITICAL" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
        { "matcher": { "id": "byRegexp", "options": "MAJOR|WARNING" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
        { "matcher": { "id": "byRegexp", "options": "HEALTHY" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
      ] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Fleet size by collector",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "server_scan:servers:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },

    { "id": 101, "type": "row", "title": "Vendor collectors (CronJobs)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }, "collapsed": false, "panels": [] },

    {
      "id": 9, "type": "timeseries", "title": "Collector silence age",
      "description": "server_scan:collector_silent_seconds — time() - max(collector_last_seen_timestamp_seconds). Fires ServerScanCollectorSilent above silentForSeconds (default 43200s = 12h, dashed line).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [{ "expr": "server_scan:collector_silent_seconds{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 5, "thresholdsStyle": { "mode": "line" } }, "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 43200 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Stale servers per collector",
      "description": "server_scan:servers_stale:max — not seen within INVENTORY_STALE_AFTER_SECONDS, or never seen. Fires ServerScanServersStale above staleServersThreshold (default 10).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [{ "expr": "server_scan:servers_stale:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Unreachable servers per collector",
      "description": "server_scan:servers_unreachable:max — of the stale ones, a BMC that did not answer.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "targets": [{ "expr": "server_scan:servers_unreachable:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Partially-read servers per collector",
      "description": "server_scan:servers_partial:max — reached, but a field this collector normally reports came back unread this run.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "targets": [{ "expr": "server_scan:servers_partial:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13, "type": "bargauge", "title": "Last run exited PARTIAL",
      "description": "server_scan:collector_last_run_partial:max — 1 if the most recent run did not see the whole fleet.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "targets": [{ "expr": "server_scan:collector_last_run_partial:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "PARTIAL" } } }] }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "lcd", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 14, "type": "timeseries", "title": "Last run duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "targets": [{ "expr": "server_scan:collector_last_run_duration_seconds:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 15, "type": "timeseries", "title": "Last run servers fetched",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
      "targets": [{ "expr": "server_scan:collector_last_run_servers_fetched:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 16, "type": "timeseries", "title": "Last run errors (ingest + collection)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "targets": [
        { "expr": "server_scan:collector_last_run_ingest_errors:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}} ingest", "refId": "A" },
        { "expr": "server_scan:collector_last_run_collection_errors:max{namespace=~\"$namespace\", source_provider=~\"$source_provider\"}", "legendFormat": "{{source_provider}} collection", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },

    { "id": 102, "type": "row", "title": "OpenShift membership jobs (nodes-status / agents-status)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 }, "collapsed": false, "panels": [] },

    {
      "id": 17, "type": "timeseries", "title": "Membership run silence age",
      "description": "server_scan:membership_run_silent_seconds — time() - max(membership_last_run_timestamp_seconds), per kind/reported_by. Fires ServerScanMembershipRunSilent above membershipSilentForSeconds (default 1800s = two 15-min nodes-status cycles) independent of match rate — this is what catches a job that runs but matches zero hostnames, which cluster_last_reported_timestamp_seconds below cannot see at all.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "targets": [{ "expr": "server_scan:membership_run_silent_seconds{namespace=~\"$namespace\"}", "legendFormat": "{{kind}} / {{reported_by}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 5, "thresholdsStyle": { "mode": "line" } }, "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1800 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 18, "type": "timeseries", "title": "Unmatched hostnames per run",
      "description": "server_scan:membership_last_run_unmatched:max — hostnames the job reported that matched no server this run. Fires ServerScanMembershipUnmatched above membershipUnmatchedThreshold (default 0). The newest job pod's log lists the actual hostnames.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "targets": [{ "expr": "server_scan:membership_last_run_unmatched:max{namespace=~\"$namespace\"}", "legendFormat": "{{kind}} / {{reported_by}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 30 }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 19, "type": "table", "title": "Membership run summary (latest)",
      "description": "One row per kind/reported_by: what the most recent real run of tools.collect_openshift reported.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "targets": [
        { "expr": "server_scan:membership_last_run_observed:max{namespace=~\"$namespace\"}", "legendFormat": "Observed", "refId": "A", "format": "table", "instant": true },
        { "expr": "server_scan:membership_last_run_matched:max{namespace=~\"$namespace\"}", "legendFormat": "Matched", "refId": "B", "format": "table", "instant": true },
        { "expr": "server_scan:membership_last_run_unmatched:max{namespace=~\"$namespace\"}", "legendFormat": "Unmatched", "refId": "C", "format": "table", "instant": true },
        { "expr": "server_scan:membership_last_run_duration_seconds:max{namespace=~\"$namespace\"}", "legendFormat": "Duration (s)", "refId": "D", "format": "table", "instant": true },
        { "expr": "server_scan:membership_last_run_partial:max{namespace=~\"$namespace\"}", "legendFormat": "Partial", "refId": "E", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "Value #A": "Observed", "Value #B": "Matched", "Value #C": "Unmatched", "Value #D": "Duration (s)", "Value #E": "Partial" } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Unmatched" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] },
        { "matcher": { "id": "byName", "options": "Partial" }, "properties": [{ "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "PARTIAL" } } }] }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] }
      ] },
      "options": { "showHeader": true }
    },
    {
      "id": 20, "type": "bargauge", "title": "Last run exited PARTIAL (membership)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 47 },
      "targets": [{ "expr": "server_scan:membership_last_run_partial:max{namespace=~\"$namespace\"}", "legendFormat": "{{kind}} / {{reported_by}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "PARTIAL" } } }] }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "lcd", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Servers held per cluster",
      "description": "server_scan:cluster_servers_held:max — INSTALLED servers naming this cluster (nodes jobs only; agents/MCE holdings are not broken out separately).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 47 },
      "targets": [{ "expr": "server_scan:cluster_servers_held:max{namespace=~\"$namespace\", cluster=~\"$cluster\"}", "legendFormat": "{{cluster}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Cluster report silence age (per-server view)",
      "description": "server_scan:cluster_silent_seconds — driven by openshift.last_reported_at, only ever set on a matched hostname. Fires ServerScanClusterSilent above membershipSilentForSeconds (default 1800s). See panel 17 for the per-job view that also catches a 0%-match run.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 55 },
      "targets": [{ "expr": "server_scan:cluster_silent_seconds{namespace=~\"$namespace\", cluster=~\"$cluster\"}", "legendFormat": "{{cluster}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 5, "thresholdsStyle": { "mode": "line" } }, "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1800 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 23, "type": "timeseries", "title": "Membership run duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 55 },
      "targets": [{ "expr": "server_scan:membership_last_run_duration_seconds:max{namespace=~\"$namespace\"}", "legendFormat": "{{kind}} / {{reported_by}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },

    { "id": 103, "type": "row", "title": "Health policies", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 63 }, "collapsed": false, "panels": [] },
    {
      "id": 24, "type": "bargauge", "title": "Top firing health policies",
      "description": "server_scan:policy_active:max — how many servers each declarative health policy currently fires on (top 15). policy_key shadowing means a server counts once per category, not once per policy.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 64 },
      "targets": [{ "expr": "topk(15, server_scan:policy_active:max{namespace=~\"$namespace\"})", "legendFormat": "{{policy_key}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-BlYlRd" }, "unit": "short" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "id": 104, "type": "row", "title": "API & platform health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 72 }, "collapsed": false, "panels": [] },
    {
      "id": 25, "type": "timeseries", "title": "HTTP request rate by status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 73 },
      "targets": [{ "expr": "sum by (status) (rate(http_requests_total{namespace=~\"$namespace\"}[5m]))", "legendFormat": "{{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }, "unit": "reqps" }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
        { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
        { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 26, "type": "timeseries", "title": "HTTP latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 73 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 5 }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 27, "type": "timeseries", "title": "MongoDB ping failure rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 81 },
      "targets": [{ "expr": "sum(rate(mongo_ping_failures_total{namespace=~\"$namespace\"}[5m]))", "legendFormat": "failures/s", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15 }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 28, "type": "timeseries", "title": "Redis cache hit/miss rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 81 },
      "targets": [{ "expr": "sum by (operation, outcome) (rate(cache_operations_total{namespace=~\"$namespace\"}[5m]))", "legendFormat": "{{operation}} {{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 29, "type": "timeseries", "title": "Fleet gauge failures over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 81 },
      "targets": [{ "expr": "sum(increase(server_scan_fleet_snapshot_failures_total{namespace=~\"$namespace\"}[5m]))", "legendFormat": "failures", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 50 }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } }
    },

    { "id": 105, "type": "row", "title": "Active alerts", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 89 }, "collapsed": false, "panels": [] },
    {
      "id": 30, "type": "table", "title": "ServerScan alerts",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 90 },
      "targets": [{ "expr": "ALERTS{alertname=~\"ServerScan.*\", namespace=~\"$namespace\"}", "refId": "A", "format": "table", "instant": true }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }, "indexByName": {} } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "alertstate" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "firing": { "color": "red" }, "pending": { "color": "orange" } } }] }] }
      ] },
      "options": { "showHeader": true }
    }
  ]
}
